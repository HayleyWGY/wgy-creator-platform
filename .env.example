# ─────────────────────────────────────────────────────────────────────────
# WGY Creator Platform — environment variables
#
# Every variable the app reads is listed here. A production deploy is checked
# at startup (lib/env.ts, via instrumentation.ts) and REFUSES TO START if any
# REQUIRED var is missing — you will see the list in the deploy logs rather
# than discovering it when a member hits an error.
#
# Copy to .env for local development. .env is gitignored — never commit real
# values.
# ─────────────────────────────────────────────────────────────────────────


# ═══ REQUIRED — the app is broken or insecure without these ═══════════════

# Runtime database connection (Supabase pooler, port 6543). Nothing works
# without it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Signs NextAuth session tokens. Absent = authentication is broken and
# insecure. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Base URL for auth callbacks. Local: http://localhost:3000. Production: the
# real origin (https://…). Wrong/absent = sign-in redirects break in prod.
NEXTAUTH_URL="http://localhost:3000"

# Supabase project URL + anon key — used by the browser for storage (image
# uploads) and realtime (chat). Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...anon..."

# Server-side Supabase key for uploads. SECRET — never expose to the client.
# Supabase Dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."

# ⚠️ DATA-LOSS KEY. AES-256 key encrypting member PII (DOB, address, phone,
# gender). Absent = every sensitive-field read/write 500s. CHANGED/LOST = all
# existing encrypted rows become permanently unreadable. Back this up in a
# password manager. Generate: openssl rand -base64 32  (must decode to 32 bytes)
FIELD_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# Distributed rate limiter (Upstash Redis REST). Absent = login brute-force and
# all API throttling are silently disabled. Upstash console → your database →
# REST API.
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AY...token..."

# Bearer token protecting /api/cron/publish-scheduled. Absent = the route 401s
# everyone, including Vercel Cron, so scheduled publishing's safety-net stops.
# Generate: openssl rand -base64 32
CRON_SECRET="replace-with-openssl-rand-base64-32"


# ═══ DEPLOY / SCRIPTS — needed to migrate, not per-request ════════════════

# Direct (non-pooled) database URL, port 5432. Used by `prisma db push` and
# maintenance scripts; the pooler hangs on schema pushes. Not read at runtime.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"


# ═══ OPTIONAL — safe to leave unset; features degrade gracefully ══════════

# Portal application-handoff (DORMANT until launch). With both unset the apply
# flow is a normal link. Set them together at launch to enable the secure
# prefill. APPLY_HANDOFF_SECRET: openssl rand -base64 32
# APPLY_HANDOFF_SECRET="..."
# NEXT_PUBLIC_PORTAL_URL="https://portal.wegotyouagency.com"

# Absolute origin used in setup-link emails. Falls back to NEXTAUTH_URL if unset.
# NEXT_PUBLIC_APP_URL="https://app.wegotyouagency.com"

# Transactional email (password reset, invites). Email is stubbed until this is
# set — sends are logged, not delivered. Resend dashboard → API Keys.
# RESEND_API_KEY="re_..."

# Stripe (billing — deferred pre-launch). Absent is fine while dormant.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Sentry error monitoring (recommended at launch). Both DSNs absent = the SDK
# is a no-op. The AUTH_TOKEN/ORG/PROJECT trio is build-time source-map upload
# only and never affects the running app.
# SENTRY_DSN="https://...@sentry.io/..."
# NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
# SENTRY_AUTH_TOKEN="..."
# SENTRY_ORG="..."
# SENTRY_PROJECT="..."


# ═══ LOCAL SCRIPTS ONLY — not a deploy variable ═══════════════════════════

# One-off Circle→WGY migration scripts. Local use only; never set in Vercel.
# CIRCLE_API_TOKEN="..."
# CIRCLE_COMMUNITY_ID="..."
# CIRCLE_SPACE_ID="..."
